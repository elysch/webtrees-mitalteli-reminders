<script>
(function () {
    var button = document.getElementById('cron_conf_copy');
    var box    = document.getElementById('cron_conf');

    if (!button || !box) {
        return;
    }

    var label = button.textContent;

    function report(ok) {
        button.textContent = ok ? button.dataset.copied : button.dataset.failed;
        window.setTimeout(function () { button.textContent = label; }, 2000);
    }

    // Fallback for non-secure contexts (plain http) where navigator.clipboard is missing.
    function legacyCopy() {
        var range = document.createRange();
        var sel   = window.getSelection();
        var ok    = false;

        range.selectNodeContents(box);
        sel.removeAllRanges();
        sel.addRange(range);

        try {
            ok = document.execCommand('copy');
        } catch (e) {
            ok = false;
        }

        sel.removeAllRanges();

        return ok;
    }

    button.addEventListener('click', function () {
        var text = box.textContent;

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(function () { report(true); }, function () { report(legacyCopy()); });
        } else {
            report(legacyCopy());
        }
    });
})();
</script>
