<?php

declare(strict_types=1);

use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\View;

/**
 * Compact one-line variant of the individual-page panel (display mode "compact").
 *
 * @var Individual $individual
 * @var bool       $is_self
 * @var bool       $is_following
 * @var string     $relationship
 * @var string     $relationship_url
 * @var string     $action_url
 * @var string     $csrf
 */

$label_follow   = I18N::translate('Remind me of this birthday');
$label_unfollow = I18N::translate('Stop reminding me');

?>
aaaa
<div class="wt-reminders-compact d-flex align-items-center flex-wrap gap-2 small">
    <?php if ($is_self) : ?>
        <span class="text-muted"><?= I18N::translate('This is your own profile.') ?></span>
    <?php else : ?>
        <?php if ($relationship !== '') : ?>
            <?php if ($relationship_url !== '') : ?>
                <a class="badge bg-secondary text-decoration-none" href="<?= e($relationship_url) ?>"
                   title="<?= e(I18N::translate('Show full relationship')) ?>"><?= e($relationship) ?></a>
            <?php else : ?>
                <span class="badge bg-secondary"><?= e($relationship) ?></span>
            <?php endif ?>
        <?php endif ?>

        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1" id="wt-reminders-follow"
                data-xref="<?= e($individual->xref()) ?>"
                data-url="<?= e($action_url) ?>"
                data-csrf="<?= e($csrf) ?>"
                data-following="<?= $is_following ? '1' : '0' ?>"
                data-label-follow="<?= e($label_follow) ?>"
                data-label-unfollow="<?= e($label_unfollow) ?>"
                aria-pressed="<?= $is_following ? 'true' : 'false' ?>"
                title="<?= e($is_following ? $label_unfollow : $label_follow) ?>">
            <span aria-hidden="true" data-role="icon"><?= $is_following ? '🔔' : '🔕' ?></span>
            <span class="visually-hidden" data-role="text"><?= e($is_following ? $label_unfollow : $label_follow) ?></span>
        </button>
    <?php endif ?>
</div>

<?php if (!$is_self) : ?>
    <?php View::push('javascript') ?>
    <script>
        (function () {
            const btn = document.getElementById('wt-reminders-follow');
            if (!btn) {
                return;
            }

            btn.addEventListener('click', function () {
                const following = btn.dataset.following === '1';
                const body = new URLSearchParams({
                    action: following ? 'unfollow' : 'follow',
                    target: btn.dataset.xref,
                    ajax: '1',
                    _csrf: btn.dataset.csrf
                });

                btn.disabled = true;

                fetch(btn.dataset.url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-CSRF-TOKEN': btn.dataset.csrf
                    },
                    body: body.toString()
                })
                    .then(function (response) {
                        if (!response.ok) {
                            throw new Error('HTTP ' + response.status);
                        }
                        return response.json();
                    })
                    .then(function () {
                        const now = !following;
                        const label = now ? btn.dataset.labelUnfollow : btn.dataset.labelFollow;
                        btn.dataset.following = now ? '1' : '0';
                        btn.setAttribute('aria-pressed', now ? 'true' : 'false');
                        btn.title = label;
                        btn.querySelector('[data-role="icon"]').textContent = now ? '🔔' : '🔕';
                        btn.querySelector('[data-role="text"]').textContent = label;
                    })
                    .catch(function () { /* keep previous state */ })
                    .finally(function () { btn.disabled = false; });
            });
        })();
    </script>
    <?php View::endpush() ?>
<?php endif ?>
